{
	"name": "atmosphere",
	"description": "Publish WordPress posts to AT Protocol (Bluesky + standard.site) via native OAuth.",
	"author": "Automattic",
	"license": "GPL-2.0-or-later",
	"private": true,
	"scripts": {
		"build": "wp-scripts build --experimental-modules",
		"start": "wp-scripts start --experimental-modules",
		"lint:js": "wp-scripts lint-js src",
		"format:js": "wp-scripts format src",
		"test:unit:js": "wp-scripts test-unit-js",
		"env-start": "wp-env start",
		"env-stop": "wp-env stop",
		"preenv-test": "wp-env start",
		"env-test": "wp-env run tests-cli --env-cwd=\"wp-content/plugins/wordpress-atmosphere\" vendor/bin/phpunit",
		"release": "node bin/release.js"
	},
	"devDependencies": {
		"@wordpress/api-fetch": "^7.48.0",
		"@wordpress/block-editor": "^16.0.0",
		"@wordpress/blocks": "^15.21.0",
		"@wordpress/components": "^38.0.0",
		"@wordpress/core-data": "^7.48.0",
		"@wordpress/data": "^10.48.0",
		"@wordpress/edit-post": "^8.48.0",
		"@wordpress/editor": "^14.48.0",
		"@wordpress/element": "^8.0.0",
		"@wordpress/env": "^11.4.0",
		"@wordpress/i18n": "^6.21.0",
		"@wordpress/interactivity": "^6.48.0",
		"@wordpress/plugins": "^7.48.0",
		"@wordpress/scripts": "^33.0.0"
	}
}
