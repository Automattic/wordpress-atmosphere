{
	"name": "atmosphere",
	"description": "Publish WordPress posts to AT Protocol (Bluesky + standard.site) via native OAuth.",
	"author": "Automattic",
	"license": "GPL-2.0-or-later",
	"private": true,
	"scripts": {
		"build": "wp-scripts build --experimental-modules",
		"start": "wp-scripts start --experimental-modules",
		"lint:js": "wp-scripts lint-js src",
		"format:js": "wp-scripts format src",
		"test:unit": "wp-scripts test-unit-jest",
		"test:unit:watch": "wp-scripts test-unit-jest --watch",
		"test:unit:debug": "wp-scripts --inspect-brk test-unit-jest --runInBand --no-cache",
		"env-start": "wp-env start",
		"env-stop": "wp-env stop",
		"preenv-test": "wp-env start",
		"env-test": "wp-env run tests-cli --env-cwd=\"wp-content/plugins/wordpress-atmosphere\" vendor/bin/phpunit",
		"release": "node bin/release.js"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/babel-preset-default": "^9.0.0",
		"@wordpress/block-editor": "^18.0.0",
		"@wordpress/blocks": "^16.0.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/core-data": "^8.0.0",
		"@wordpress/data": "^10.48.0",
		"@wordpress/edit-post": "^8.48.0",
		"@wordpress/editor": "^16.0.0",
		"@wordpress/element": "^8.0.0",
		"@wordpress/env": "^11.17.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/interactivity": "^8.0.0",
		"@wordpress/jest-preset-default": "^14.2.0",
		"@wordpress/plugins": "^7.48.0",
		"@wordpress/scripts": "^37.0.0",
		"babel-jest": "^30.5.2",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2"
	}
}
